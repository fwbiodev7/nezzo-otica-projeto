# O modo local funciona sem estas variáveis; Gemini requer GEMINI_API_KEY.
# O painel fica bloqueado até configurar os dois segredos gerados por npm run setup:admin.
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
# Origem pública exata (https://seu-dominio), necessária se houver proxy com URL interna diferente.
APP_ORIGIN=
# Opcional: somente com ingresso confiável que substitui o cabeçalho e impede acesso direto.
# Sem configuração, as requisições compartilham um limite conservador por instância.
TRUSTED_PROXY_IP_HEADER=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=meta-llama/Llama-3.2-11B-Vision-Instruct
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct
NEXT_PUBLIC_WHATSAPP_NUMBER=5535998892492
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
